{
  "name": "they-spy-extension",
  "version": "0.1.0",
  "private": true,
  "description": "See what websites tell advertisers about you. Everything stays on your device.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox && wxt zip -b edge",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3 --warnings-as-errors",
    "format": "prettier --write .",
    "check:manifest": "node scripts/check-manifest.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:manifest && npm run lint:firefox && npm run test:e2e"
  },
  "dependencies": {
    "idb": "8.0.4",
    "tldts": "7.4.18"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "web-ext": "10.8.0",
    "wxt": "0.21.4"
  }
}
